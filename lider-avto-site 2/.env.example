# Serverda shu faylni .env nomi bilan nusxalang:  cp .env.example .env
# Keyin qiymatlarni to'ldiring. .env GitHub'ga YUBORILMAYDI.

# Yangi kalit yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Domen va/yoki server IP (vergul bilan, probelsiz)
DJANGO_ALLOWED_HOSTS=sayt.uz,www.sayt.uz,1.2.3.4

# Faqat certbot (HTTPS) o'rnatilgandan keyin 1 qiling
DJANGO_HTTPS=0
# HTTPS bo'lgach: https://sayt.uz,https://www.sayt.uz
DJANGO_CSRF_TRUSTED_ORIGINS=

# Telegram bot — yangi buyurtma xabarlari uchun (ixtiyoriy)
# Bot token: @BotFather dan oling. Chat ID: @userinfobot orqali oling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
